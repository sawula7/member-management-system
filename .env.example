# Database Configuration
# MySQL connection string
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/member_management"

# NextAuth Configuration
# Generate a secret: openssl rand -base64 32
AUTH_SECRET="your-super-secret-key-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"

# PayHere Payment Gateway Configuration
# Get these credentials from your PayHere account
# Sandbox: https://sandbox.payhere.lk
# Production: https://www.payhere.lk
PAYHERE_MERCHANT_ID="your_merchant_id"
PAYHERE_MERCHANT_SECRET="your_merchant_secret"

# Public PayHere Configuration (accessible in browser)
NEXT_PUBLIC_PAYHERE_MERCHANT_ID="your_merchant_id"

# Application Configuration
NODE_ENV="development"
